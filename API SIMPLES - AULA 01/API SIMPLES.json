{"openapi":"3.1.0","info":{"title":"Calculadora API","description":"API simples que recebe dois números e uma operação (soma, subtracao, multiplicacao, divisao) e retorna o resultado em JSON.","version":"0.1.0"},"paths":{"/calcular":{"post":{"summary":"Executa cálculo entre dois números","description":"Recebe dois números e o tipo de operação para retornar o resultado em JSON.","operationId":"calcular_calcular_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DadosEntrada"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultadoSaida"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"DadosEntrada":{"properties":{"a":{"type":"number","title":"A","example":10},"b":{"type":"number","title":"B","example":5},"operacao":{"type":"string","enum":["soma","subtracao","subtração","multiplicacao","divisao","divisão"],"title":"Operacao","description":"Operação a ser realizada: soma, subtracao/subtração, multiplicacao ou divisao/divisão","example":"soma"}},"type":"object","required":["a","b","operacao"],"title":"DadosEntrada"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"ResultadoSaida":{"properties":{"a":{"type":"number","title":"A"},"b":{"type":"number","title":"B"},"operacao":{"type":"string","title":"Operacao"},"resultado":{"type":"number","title":"Resultado"}},"type":"object","required":["a","b","operacao","resultado"],"title":"ResultadoSaida"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}